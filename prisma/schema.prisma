generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid())
  username String @unique
  password String
}

model Profile {
  id           String  @id @default(uuid())
  name         String
  designation  String
  aboutMe      String
  aboutPhotoUrl String?
  email        String?
  phone        String?
  showPhone    Boolean @default(false)
  whatsapp     String?
  resumeUrl    String?
  githubUrl    String?
  linkedinUrl  String?
  facebookUrl  String?
  heroPhotoUrl String?
  tagline      String?
  location     String?
  availability String?
}

model Skill {
  id       String  @id @default(uuid())
  name     String
  category String
  imageUrl String?
  order    Int     @default(0)
}

model Education {
  id          String @id @default(uuid())
  institution String
  degree      String
  startYear   String
  endYear     String
  description String
  order       Int    @default(0)
}

model Project {
  id            String   @id @default(uuid())
  slug          String   @unique
  name          String
  imageUrl      String?
  images        String[] @default([])
  mainTechStack String[]
  description   String
  liveLink      String?
  githubLink    String?
  challenges    String
  futurePlans   String
  role          String?
  architecture  String?
  impact        String?
  featured      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  FREELANCE
  CONTRACT
}

model Experience {
  id             String         @id @default(uuid())
  company        String
  role           String
  employmentType EmploymentType @default(FULL_TIME)
  location       String?
  startDate      DateTime
  endDate        DateTime?
  achievements   String[]       @default([])
  techStack      String[]       @default([])
  companyUrl     String?
  order          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt
}
