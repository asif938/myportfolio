# Copy to .env and fill in. Never commit real values.
# Variables starting with NEXT_PUBLIC_ are sent to the browser: never put secrets in them.

# --- Database (PostgreSQL, e.g. Neon) -------------------------------------------
# Tip for Neon: append &connect_timeout=15 so builds survive a suspended compute waking up.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&connect_timeout=15"

# --- Auth (NextAuth) -------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Used by `npx prisma db seed` to create the first admin (password: 12+ characters).
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# --- Site ------------------------------------------------------------------------
# Public URL without trailing slash; used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Cloudinary (image uploads) --------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Contact form (Web3Forms public access key) ----------------------------------
NEXT_PUBLIC_WEB3FORMS_KEY=""

# --- Rate limiting (Upstash Redis) -----------------------------------------------
# Optional locally (falls back to in-memory limits), strongly recommended in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- AI chatbot ------------------------------------------------------------------
# Encrypts the API key saved in the admin panel (/admin/ai). 32 bytes, base64.
# Generate: openssl rand -base64 32
# Changing it makes the stored key unreadable (just enter the key again in /admin/ai).
SETTINGS_ENCRYPTION_KEY=""

# Optional fallback, used only when nothing is saved in /admin/ai:
# AI_PROVIDER: anthropic | openai | google | openrouter
AI_PROVIDER=""
AI_MODEL=""
# Provider keys (also used when /admin/ai has no stored key for that provider).
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""
OPENROUTER_API_KEY=""
